# Backend base URL — use your machine's LAN IP when testing on a physical device
# e.g. http://192.168.1.10:5000
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Analytics is served by the same Flask server under /analytics (no separate process needed)
EXPO_PUBLIC_ANALYTICS_BASE_URL=http://localhost:5000/analytics

# Set to "true" to run the app fully offline with realistic HK demo data.
# All API calls are intercepted and return fixtures from src/constants/fixtures.ts.
# Useful for demos, screenshots, and development without a running backend.
EXPO_PUBLIC_DEMO_MODE=false

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
