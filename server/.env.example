# Mobile server configuration
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# Database — SQLite by default, swap for PostgreSQL in production
# DATABASE_URL=postgresql://user:pass@localhost:5432/retouch_mobile
DATABASE_URL=sqlite:///retouch_mobile.db

# Storage — local filesystem by default
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# Gemini OCR — required for real receipt parsing
GEMINI_API_KEY=

# Gemini model (optional — defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Server — must match EXPO_PUBLIC_API_BASE_URL in the frontend .env
PORT=5000
