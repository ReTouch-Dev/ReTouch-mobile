{
  "expo": {
    "name": "ReTouch",
    "slug": "retouch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F9FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.retouch.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow ReTouch to access your photos to scan receipts.",
        "NSCameraUsageDescription": "Allow ReTouch to use your camera to capture receipts.",
        "NSPhotoLibraryAddUsageDescription": "Allow ReTouch to save receipt images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F9FF"
      },
      "package": "com.retouch.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ReTouch to access your photos to scan receipts.",
          "cameraPermission": "Allow ReTouch to use your camera to capture receipts."
        }
      ],
      "expo-asset"
    ],
    "scheme": "retouch",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "be530f77-0ac2-41c9-b7a3-a211ffbb24fb"
      }
    },
    "owner": "retouch"
  }
}
